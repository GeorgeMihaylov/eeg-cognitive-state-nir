    }
  },
  "research_hypothesis": "An auxiliary CORN objective can improve ordinal error characteristics of the primary categorical Transformer prediction while preserving more categorical discrimination than a pure CORN head.",
  "architecture": {
    "model_name": "torch_transformer",
    "head_type": "categorical_corn",
    "num_classes": 5,
    "num_thresholds": 4,
    "input_shapes": {
      "eeg_only": [8, 168],
      "eeg_pow": [8, 448]
    },
    "single_encoder_call": true,
    "shared_representation": "TorchFeatureTransformerClassifier.encode output",
    "categorical_head": {
      "registered_name": "classifier",
      "state_dict_prefixes": [
        "classifier.0.",
        "classifier.1.",
        "classifier.4."
      ],
      "output_shape": ["batch", 5],
      "unchanged_from_legacy": true
    },
    "auxiliary_head": {
      "class": "CornOrdinalHead",
      "registered_name": "auxiliary_ordinal_head",
      "state_dict_prefix": "auxiliary_ordinal_head.",
      "output_shape": ["batch", 4],
      "duplicates_existing_corn": false
    },
    "projected_parameter_counts": {
      "eeg_only": 322313,
      "eeg_pow": 358153,
      "hard_coded_in_model": false
    }
  },
  "forward_output": {
    "recommended_kind": "NamedTuple",
    "type_name": "CategoricalCornOutput",
    "fields": {
      "categorical_logits": ["batch", 5],
      "ordinal_logits": ["batch", 4]
    },
    "legacy_single_head_return_type": "torch.Tensor",
    "shape_based_semantic_inference_allowed": false
  },
  "objective": {
    "type": "categorical_plus_auxiliary_corn",
    "formula": "cross_entropy(categorical_logits,y) + auxiliary_weight * corn_loss(ordinal_logits,y)",
    "categorical_normalization": "sum cross entropy divided by sample count",
    "corn_normalization": "sum(mask * BCEWithLogits) divided by sum(mask)",
    "reuse_existing_corn_loss": true,
    "allowed_auxiliary_weight": {
      "type": "finite_float",
      "minimum": 0.0
    },
    "excluded_terms": [
      "probability_consistency",
      "regression_loss",
      "subject_weights",
      "class_weights",
      "changed_corn_risk_sets"
    ],
    "training_log_columns": [
      "train_total_loss",
      "train_categorical_loss",
      "train_ordinal_loss",
      "validation_total_loss",
      "validation_categorical_loss",
      "validation_ordinal_loss"
    ],
    "legacy_log_aliases": {
      "train_loss": "train_total_loss",
      "validation_loss": "validation_total_loss"
    }
  },
  "prediction_semantics": {
    "primary_head": "categorical",
    "class_probabilities": "softmax(categorical_logits)",
    "y_pred": "argmax(class_probabilities)",
    "primary_metrics_probability_source": "categorical class probabilities only",
    "auxiliary_head_role": "diagnostic_only",
    "auxiliary_threshold_probability_semantics": "cumulative P(y > k)",
    "auxiliary_prediction": "count(aux_threshold_probability >= 0.5)",
    "head_ensembling_allowed": false,
    "outer_test_head_selection_allowed": false
  },
