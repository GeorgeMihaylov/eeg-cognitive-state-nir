      "classifier.0.*",
      "classifier.1.*",
      "classifier.4.*"
    ],
    "coral": {
      "score": "s = w^T h + b",
      "cutpoints": "c0 free; ck = c(k-1) + softplus(delta_k) + 1e-6",
      "initial_cutpoints": [-1.5, -0.5, 0.5, 1.5],
      "loss": "sum BCEWithLogits / (N * (K-1))"
    },
    "corn": {
      "target": "1[y > k]",
      "risk_mask": "1[y >= k]",
      "loss": "sum(mask * BCEWithLogits) / sum(mask)"
    },
    "probability_tolerance": 1e-7,
    "prediction_rule": "count(cumulative_probability >= 0.5)",
    "expected_rank": "sum(cumulative_probability)",
    "categorical_prediction_rule": "argmax(softmax(logits))"
  },
